        {
          "resource": "repo://agent/sandboxes/state.py#L326-L401",
          "version": "repo-lines-v1:sha256:137c285eb2b5e87d826fbf19fef5186751951cb296e3607d8cb1daf8f949191d:"
        }
      ]
    },
